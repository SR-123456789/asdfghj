"use strict";

function main(lines: string[]): void {
  // 1行目: n, m, x, y
  const [n, m, x, y] = lines[0].split(" ").map(Number);
  // 2行目: テーブルの座席数 a_i
  const tableSizes = lines[1].split(" ").map(Number);
  // 3行目: グループの人数 b_i
  const groupSizes = lines[2].split(" ").map(Number);

  // --- 前処理: テーブル部分集合の座席数とテーブル数を計算 ---
  const maxMask = 1 << n; // 2^n
  const sumOfSubset = new Array<number>(maxMask).fill(0);
  const countOfSubset = new Array<number>(maxMask).fill(0);

  for (let s = 0; s < maxMask; s++) {
    let sum = 0;
    let cnt = 0;
    for (let j = 0; j < n; j++) {
      if ((s >> j) & 1) {
        sum += tableSizes[j];
        cnt++;
      }
    }
    sumOfSubset[s] = sum;
    countOfSubset[s] = cnt;
  }

  // --- グループを s という部分集合で収容したときのコストを計算 ---
  //    収容できないなら Infinity
  //    収容できるなら (|s|-1)*y
  const costForGroup = Array.from({ length: m }, () => new Array<number>(maxMask).fill(Infinity));
  for (let i = 0; i < m; i++) {
    for (let s = 0; s < maxMask; s++) {
      if (sumOfSubset[s] >= groupSizes[i]) {
        costForGroup[i][s] = (countOfSubset[s] - 1) * y;
      }
    }
  }

  // --- DP配列: dp[i][mask] = i番目のグループを割り当て終わった時点で
  //             使用済テーブルが mask のときの最小コスト
  const dp = Array.from({ length: m + 1 }, () => new Array<number>(maxMask).fill(Infinity));
  dp[0][0] = 0; // 最初はグループ0人割り当て済み＆テーブル未使用=0でコスト0

  for (let i = 0; i < m; i++) {
    for (let mask = 0; mask < maxMask; mask++) {
      const baseCost = dp[i][mask];
      if (baseCost === Infinity) continue;

      // 1) グループ i を追い返す
      {
        const newCost = baseCost + groupSizes[i] * x;
        dp[i + 1][mask] = Math.min(dp[i + 1][mask], newCost);
      }

      // 2) グループ i を収容できる部分集合 s を選ぶ
      //    (mask & s) == 0 であること (まだ使ってないテーブルを使う)
      const freeMask = ((1 << n) - 1) ^ mask; // maskのビットが立っていないテーブル
      // 部分集合 s は freeMask の部分集合全体を走査
      // 速度が気になる場合は最適化が必要かも
      let s = freeMask;
      while (true) {
        // costForGroup[i][s] が Infinity でなければ収容可能
        const costSeat = costForGroup[i][s];
        if (costSeat !== Infinity) {
          const newMask = mask | s;
          const newCost = baseCost + costSeat;
          if (newCost < dp[i + 1][newMask]) {
            dp[i + 1][newMask] = newCost;
          }
        }

        if (s === 0) break;
        s = (s - 1) & freeMask; 
        // ビットマスクの部分集合を列挙する典型的テクニック
      }
    }
  }

  // --- 答え: dp[m][mask] の最小値 (どんなmaskでもOK)
  let ans = Infinity;
  for (let mask = 0; mask < maxMask; mask++) {
    ans = Math.min(ans, dp[m][mask]);
  }

  console.log(ans);
}

function runWithStdin() {
  let input = "";
  process.stdin.resume();
  process.stdin.setEncoding("utf8");

  process.stdin.on("data", (v) => {
    input += v;
  });
  process.stdin.on("end", () => {
    main(input.trim().split("\n"));
  });
}

runWithStdin();
